{
	"name": "@cloudcannon/editable-regions-check",
	"version": "0.0.1",
	"description": "Validate editable region markup in a site's built HTML",
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=20.19"
	},
	"bin": {
		"editable-regions-check": "dist/cli.js"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"typecheck": "tsc --noEmit",
		"lint": "biome check",
		"lint-autofix": "biome check --write",
		"test": "vitest run",
		"docs": "node scripts/generate-rules-doc.ts"
	},
	"dependencies": {
		"hast-util-from-html": "^2.0.3",
		"property-information": "^7.2.0",
		"smol-toml": "^1.9.0",
		"tinyglobby": "^0.2.17",
		"vfile": "^6.0.3",
		"vfile-message": "^4.0.3",
		"vfile-reporter": "^8.1.1",
		"yaml": "^2.9.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.13",
		"@types/hast": "^3.0.5",
		"@types/node": "^26.6.2",
		"@types/unist": "^3.0.3",
		"typescript": "^7.0.2",
		"vitest": "^5.0.1"
	}
}
