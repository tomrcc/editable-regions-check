{
	"$schema": "https://biomejs.dev/schemas/2.5.13/schema.json",
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"src/**",
			"scripts/**",
			"*.ts",
			"*.json",
			"!dist",
			"!**/*.html"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"style": {
				"noParameterAssign": "off",
				"noInferrableTypes": "off"
			},
			"complexity": {
				"noForEach": "off"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	}
}
